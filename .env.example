# Never commit real values. Separate credentials/roles are required.
DATABASE_URL=postgres://MIGRATION_OWNER:PASSWORD@HOST:5432/NEW_DATABASE
RUNTIME_DATABASE_URL=postgres://RUNTIME_LOGIN:PASSWORD@HOST:5432/NEW_DATABASE
BILLING_DATABASE_URL=postgres://BILLING_LOGIN:PASSWORD@HOST:5432/NEW_DATABASE
SUPPORT_DATABASE_URL=postgres://SUPPORT_LOGIN:PASSWORD@HOST:5432/NEW_DATABASE
SUPABASE_URL=https://YOUR_NEW_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
RAZORPAY_KEY_ID=YOUR_TEST_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_SERVER_ONLY_TEST_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_SERVER_ONLY_WEBHOOK_SECRET
# Authentication phase: distinct server login with ONLY exam_auth membership.
AUTH_DATABASE_URL=postgres://AUTH_LOGIN:PASSWORD@HOST:5432/NEW_DATABASE
APP_ORIGIN=https://YOUR_AUTH_HOST
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
PORT=3000
HOST=127.0.0.1
